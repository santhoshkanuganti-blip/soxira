# ── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Neon, Supabase, Railway, or your own server)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/soxira?schema=public"

# ── Admin Authentication ──────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET="change-this-to-a-long-random-secret-at-least-32-characters"

# ── Cloudinary (Media Library) ────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ── Contact Form ──────────────────────────────────────────────────────────────
CONTACT_NOTIFICATION_RECIPIENTS=info@soxira.com,info@soxirasolutions.com
CONTACT_FROM_EMAIL=Soxira Contact <info@soxira.com>

SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@soxira.com
SMTP_PASS=replace-with-your-hostinger-email-password

# Optional fallback email provider
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
